local function resolveDifficultyFromUI()
    if game.PlaceId==14916516914 then
        local text=game.Players.LocalPlayer.PlayerGui.Interface.Equipment.Categories.Upgrades.Main.Title.Text
        if text=="UPGRADES" then PressButton(game:GetService("Players").LocalPlayer.PlayerGui.Interface.Topbar.Main.Categories.Equipment.Interact) end
        local raw=text:match("%[(.-)%]")
        local difficultyMap={["E- GRADE"]="Easy",["E+ GRADE"]="Normal",["D+ GRADE"]="Hard",["B- GRADE"]="Severe",["A- GRADE"]="Aberrant"}
        if not raw or raw=="Best For You" then
            if _G.save.AutoJoinMission or _G.save.AutoJoinMissionBoost then return _G.save.SelectMissionDifficulty
            elseif _G.save.AutoJoinRaid then return _G.save.SelectRaidDifficulty
            else return "Easy" end
        end
        if not raw:find("%+") and not raw:find("%-") then raw=raw:gsub(" GRADE","- GRADE") end
        return difficultyMap[raw] or "Easy"
    end
end

local function CreateAndStart(data)
    if game.PlaceId==14916516914 then
        local ok,res=pcall(function() return GET:InvokeServer("S_Missions","Create",data) end)
        print("CREATE:",ok,res)
        if ok and typeof(res)=="Instance" then
            task.wait(1)
            local ok2,res2=pcall(function() return GET:InvokeServer("S_Missions","Start") end)
            print("START:",ok2,res2)
            return true
        end
        return false
    end
end

