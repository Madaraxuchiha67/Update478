if game.PlaceId~=14916516914 then
    local BladeUI=LP.PlayerGui.Interface.HUD.Main.Top["7"].Blades
    local Gradient=BladeUI.Inner.Bar.Gradient
    local SetsLabel=BladeUI.Sets

    local function TweenTo(cf,speed)
        local char=LP.Character if not char then return end
        local hrp=char:FindFirstChild("HumanoidRootPart")
        local hum=char:FindFirstChild("Humanoid")
        if not hrp or not hum or hum.Health<=0 then return end
        local distance=(hrp.Position-cf.Position).Magnitude
        local time=distance/speed
        local tween=TweenService:Create(hrp,TweenInfo.new(time,Enum.EasingStyle.Linear),{CFrame=cf})
        tween:Play()
        return tween
    end

    local function GetHRP()
        local char=LP.Character if not char then return nil end
        local hrp=char:FindFirstChild("HumanoidRootPart")
        local hum=char:FindFirstChild("Humanoid")
        if not hrp or not hum then return nil end
        if hum.Health<=0 then return nil end
        return hrp
    end

    local function Refill()
        local refillPart=nil
        for _,v in pairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                if v.Name:lower():find("refill") or v.Name:lower():find("fill") then
                    local display=v:FindFirstChild("Display")
                    if display then
                        local ok,title=pcall(function() return display.Main.Top.Title.Text end)
                        if ok then if title=="REFILLS: 0 / 3 [R]" then else refillPart=v break end end
                    end
                end
            end
        end
        if not refillPart then return end
        TweenTo(refillPart.CFrame,6000)
        pcall(function() game:GetService("ReplicatedStorage").Assets.Remotes.POST:FireServer("Attacks","Reload",refillPart) end)
    end

    local function ChangeBlade()
        pcall(function() game:GetService("ReplicatedStorage").Assets.Remotes.GET:InvokeServer("Blades","Reload") end)
    end

    local function CheckBlade()
        local x=Gradient.Offset.X
        if x<0 then
            local bladeOk=false
            pcall(function()
                local rig=workspace.Characters[LP.Name]["Rig_"..LP.Name]
                local blade=rig.LeftHand.Blade_1
                if blade.Transparency==0 then bladeOk=true end
            end)
            if bladeOk then return false end
            if SetsLabel.Text=="0 / 3" then Refill() else ChangeBlade() end
            return true
        end
        return false
    end

    local function GetClosestTitan()
        local closestNape,closestEyes,closestTitan
        local distance=math.huge
        local origin
        local attackTitan=workspace:FindFirstChild("Unclimbable") and workspace.Unclimbable:FindFirstChild("Background") and workspace.Unclimbable.Background:FindFirstChild("Attack_Titan")
        local boat=workspace:FindFirstChild("Unclimbable") and workspace.Unclimbable:FindFirstChild("Objective") and workspace.Unclimbable.Objective:FindFirstChild("Boat1")
        if attackTitan then origin=attackTitan.PrimaryPart or attackTitan:FindFirstChildWhichIsA("BasePart")
        elseif boat then origin=boat.PrimaryPart or boat:FindFirstChildWhichIsA("BasePart")
        else origin=GetHRP() end
        if not origin then return end
        for _,Titan in pairs(workspace.Titans:GetChildren()) do
            if Titan:IsA("Model") then
                local humanoid=Titan:FindFirstChild("Humanoid")
                local hitboxes=Titan:FindFirstChild("Hitboxes")
                local hit=hitboxes and hitboxes:FindFirstChild("Hit")
                local nape=hit and hit:FindFirstChild("Nape")
                local eyes=hit and Titan:FindFirstChild("Head")
                if humanoid and humanoid.Health>0 and nape and eyes and nape:IsA("BasePart") and eyes:IsA("BasePart") then
                    local mag=(origin.Position-eyes.Position).Magnitude
                    if mag<distance then distance=mag closestNape=nape closestEyes=eyes closestTitan=Titan end
                end
            end
        end
        return closestNape,closestEyes,closestTitan
    end

    local function Attack()
        local POST2=game:GetService("ReplicatedStorage").Assets.Remotes.POST
        local Nape,Eyes,Titan=GetClosestTitan()
        if not Titan then return end
        local SaveHit={} local PositionHit={"Nape","Eyes"}
        POST2:FireServer("Attacks","Slash",true)
        if Titan:FindFirstChild("Hitboxes") then
            local HitRandom=math.random(1,#PositionHit)
            local Hit=Titan.Hitboxes.Hit[PositionHit[HitRandom]]
            if #SaveHit>=#PositionHit then SaveHit={} end
            if not table.find(SaveHit,Hit.Name) then
                table.insert(SaveHit,Hit.Name)
                POST2:FireServer("Hitboxes","Register",Hit,Titan:GetAttribute("Distance")+1000,1)
            end
        end
        POST2:FireServer("Attacks","Slash",false)
    end

    task.spawn(function()
        while task.wait(0.01) do
            if _G.save.AutoFarmTitan then
                pcall(function()
                    if game:GetService("Players").LocalPlayer.PlayerGui.Interface.Skip.Visible then
                        PressButton(game:GetService("Players").LocalPlayer.PlayerGui.Interface.Skip.Interact)
                    end
                    local hrp=GetHRP() if not hrp then return end
                    if CheckBlade() then return end
                    local Nape,Eyes,Titan=GetClosestTitan()
                    if not Nape or not Eyes or not Titan then return end
                    local targetCF=Eyes.CFrame*CFrame.new(0,125,125)
                    local distance=(hrp.Position-targetCF.Position).Magnitude
                    if distance<=195 then
                        hrp.CFrame=targetCF Attack()
                    else
                        local savedY=hrp.Position.Y
                        local tween=TweenTo(targetCF,6000)
                        if tween then
                            local fallConnection=game:GetService("RunService").Heartbeat:Connect(function()
                                local h=GetHRP()
                                if h and h.Position.Y<savedY-10 then h.CFrame=CFrame.new(h.Position.X,savedY,h.Position.Z) end
                            end)
                            tween.Completed:Wait() fallConnection:Disconnect() Attack()
                        else Attack() end
                    end
                end)
            end
        end
    end)

