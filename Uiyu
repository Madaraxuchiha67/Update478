                task.wait(0.08)
                if isTitanForm() then
                    for i=1,3 do pressMouseCenter() task.wait(0.1) end
                end
                task.wait(attackDelay)
            else task.wait(0.3) end
        else task.wait(0.5) end
    end
end)

