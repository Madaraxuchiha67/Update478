local function wh_sendRaidEnd(player,data,result)
    local raidInfo=RAIDS_WH[data.raidName] or RAIDS_WH["Unknown Raid"]
    local elapsed=os.time()-(data.startTime or os.time())
    local resultEmoji=(result=="Victory") and "🏆" or "💀"
