    local serums,perks,scrolls,artifacts,potions,currencies,skins,misc={},{},{},{},{},{},{},{}
    for _,r in ipairs(data.rewards or {}) do
        local n=r.name
        if n:find("Serum") then table.insert(serums,r)
        elseif n:find("Perk") then table.insert(perks,r)
        elseif n:find("Scroll") then table.insert(scrolls,r)
        elseif n:find("Artifact") or n:find("Cloak") or n:find("Scars") or n:find("Backpack") or n:find("Rifle") then table.insert(artifacts,r)
        elseif n:find("Potion") then table.insert(potions,r)
        elseif n=="Gold" or n=="Gems" or n=="Spins" or n=="Shards" or n=="Canes" then table.insert(currencies,r)
        elseif n:find("Skin") or n:find("Set") then table.insert(skins,r)
        else table.insert(misc,r) end
