local function wh_formatNumber(n)
    local s=tostring(math.floor(n)) local result="" local count=0
    for i=#s,1,-1 do count=count+1 result=s:sub(i,i)..result if count%3==0 and i~=1 then result=","..result end end
    return result
end

local function wh_formatDuration(seconds)
    return string.format("%d m %02d s",math.floor(seconds/60),math.floor(seconds%60))
end

local function wh_rewardIcon(name) return REWARD_ICONS_WH[name] or REWARD_ICONS_WH["Unknown Reward"] end

local function wh_buildRewardLines(rewards)
    if not rewards or #rewards==0 then return "> *No rewards recorded.*" end
    local lines={}
    for _,r in ipairs(rewards) do
        local icon=wh_rewardIcon(r.name)
        local amtStr=(r.amount and r.amount>1) and (" x**"..r.amount.."**") or ""
        table.insert(lines,"> "..icon.." "..r.name..amtStr)
    end
    return table.concat(lines,"\n")
end

