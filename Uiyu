    local fields={{name="⚔️  Damage",value="`"..wh_formatNumber(data.damageDealt).."`",inline=true},{name="⏱️  Time",value="`"..wh_formatDuration(elapsed).."`",inline=true},{name="⚡  Difficulty",value=data.difficulty or "Unknown",inline=true}}
    local function addField(label,list) if #list>0 then table.insert(fields,{name=label,value=wh_buildRewardLines(list),inline=false}) end end
    addField("🔴  Serums",serums) addField("🟪  Perks",perks) addField("📜  Prestige Scrolls",scrolls)
    addField("🏺  Artifacts",artifacts) addField("🍀  Potions",potions) addField("🗡️  Skins",skins)
    addField("🪙  Currencies",currencies) addField("📦  Other",misc)
    if #fields==3 then table.insert(fields,{name="📦  Rewards",value="> *No rewards dropped.*",inline=false}) end
    local embed={
        title=resultEmoji.."  Raid "..result.." — "..data.raidName,
        description=string.format("**%s** finished their raid!\n> 📅 <t:%d:F>",player.DisplayName,os.time()),
        color=resultColor,fields=fields,timestamp=wh_timestamp(),
